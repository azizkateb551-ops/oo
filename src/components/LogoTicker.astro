---
/* Same approved ticker section, reduced to one centered logo as requested. */
---

<section class="section">
  <div class="w-layout-blockcontainer container padding-4-5rem w-container">
    <div class="brands-wrapper">
      <div class="brands-grid slide-up-animation single-brand-grid">
        <div class="logos-wrapper single-brand-logo">
          <img width="Auto" height="Auto" alt="ORANGE" src="/images/orange-logo.png" loading="eager" class="invert" />
        </div>
      </div>
    </div>
    <div class="space-7rem"></div>
  </div>
</section>
