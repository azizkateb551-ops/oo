---
/* Exact markup from the approved Webflow page. */
---

<section class="section hero-section">
  <div class="w-layout-blockcontainer container padding-4-5rem w-container">
    <div class="space-7rem"></div><div class="hero-flex">
      <div class="hero-block slide-from-right-animation">
        <div class="hero-text-block">
          <div class="subheading-flex">
            <div class="icon-wrapper background-primary">
              <img
                width="Auto"
                height="Auto"
                alt=""
                src="/images/svg_bkz3.svg"
                loading="eager"
                class="small-icon"
              />
            </div><h5>طاقة متنقلة</h5>
          </div><h1 class="hero-text">
            <span>قوة كبيرة</span><span class="italics">بحجم</span><span class="italics">الجيب</span>
          </h1><div class="hero-line"></div>
        </div><div class="card-flex-wrapper">
          <div class="card background-primary">
            <div class="line-flex">
              <div class="line"></div><h5>جودة موثوقة</h5><div class="line">
              </div>
            </div><div class="move-flex">
              <h4
                data-w-id="7f686655-205d-dfce-349c-464c2a11efdc"
                style="-webkit-transform:translate3d(0, 0%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 0%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 0%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 0%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0)"
                class="move"
              >
                بدون سلك
              </h4><h4
                data-w-id="2654ea20-eee1-abff-ff89-8a6ab3d2ad9d"
                style="-webkit-transform:translate3d(0, 0%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 0%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 0%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 0%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0)"
                class="move-up"
              >
                شحن مباشر
              </h4>
            </div><img
              width="Auto"
              height="Auto"
              alt="icon"
              src="/images/charger.svg"
              loading="eager"
              class="icon"
            />
          </div><div class="card font-white"><h2>10K+</h2><h5>عميل</h5></div>
        </div>
      </div><div class="hero-image-wrapper slide-from-left-animation">
        <div class="cut-out-wrapper align-center">
          <div class="hero-heading-wrapper">
            <div class="hero-heading">
              <div class="hero-heading-flex">
                <img
                  width="Auto"
                  height="Auto"
                  alt="Dot Icon"
                  src="/images/svg_2ltj.svg"
                  loading="eager"
                  class="arrow"
                /><h5 class="hero-heading-text">شحن سريع 20W</h5>
              </div><div class="hero-heading-flex">
                <img
                  width="Auto"
                  height="Auto"
                  alt="Dot Icon"
                  src="/images/svg_2ltj.svg"
                  loading="eager"
                  class="arrow"
                /><h5 class="hero-heading-text">شحن سريع 20W</h5>
              </div><div class="hero-heading-flex">
                <img
                  width="Auto"
                  height="Auto"
                  alt="Dot Icon"
                  src="/images/svg_2ltj.svg"
                  loading="eager"
                  class="arrow"
                /><h5 class="hero-heading-text">شحن سريع 20W</h5>
              </div><div class="hero-heading-flex">
                <img
                  width="Auto"
                  height="Auto"
                  alt="Dot Icon"
                  src="/images/svg_2ltj.svg"
                  loading="eager"
                  class="arrow"
                /><h5 class="hero-heading-text">شحن سريع 20W</h5>
              </div><div class="hero-heading-flex">
                <img
                  width="Auto"
                  height="Auto"
                  alt="Dot Icon"
                  src="/images/svg_2ltj.svg"
                  loading="eager"
                  class="arrow"
                /><h5 class="hero-heading-text">شحن سريع 20W</h5>
              </div>
            </div>
          </div><img
            src="/images/top-20left.svg"
            loading="lazy"
            alt="Cut out SVG"
            class="cut-out-image top-left-absolute"
          />
        </div><div class="cut-out-flex align-bottom">
          <img
            src="/images/bottom-20left.svg"
            loading="lazy"
            alt="Cut out SVG"
            class="cut-out-image"
          /><img
            src="/images/bottom-20right-20.svg"
            loading="lazy"
            alt="Cut out SVG"
            class="cut-out-image"
          /><a href="#explore" class="arrow-border-wrapper w-inline-block"
            ><div
              data-w-id="022bdf7a-1da5-487f-e90a-10a13619b2dd"
              class="icon-wrapper"
            >
              <img
                width="Auto"
                height="Auto"
                alt="arrow up"
                src="/images/arrow_outward.svg"
                loading="eager"
                class="arrow invert"
              />
            </div></a>
        </div><img
          src="/images/mo-09.webp"
          loading="lazy"
          alt=""
          class="hero-image"
        /><a
          href="#learn-more"
          data-w-id="5df85663-d46d-b744-b25a-bb603e0e3bf9"
          style="opacity:0"
          class="spinner-wrapper w-inline-block"
          ><div
            data-w-id="5df85663-d46d-b744-b25a-bb603e0e3bfa"
            class="spinner-image"
          >
          </div></a>
      </div>
    </div><div class="space-7rem"></div>
  </div>
</section>
